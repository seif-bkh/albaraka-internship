# ============================================================
# Docker Compose environment
#
#   cp .env.docker.example .env
#
# Then set RAGLAB_URL (and RAGLAB_TOKEN if the service requires one) and
# generate a JWT_SECRET. .env is gitignored — never commit real values.
# ============================================================

# --- REQUIRED: where the assistant lives ---
# RAGLab is the only engine and it is external to this compose file.
# Address it like production: http://<ip>:<port>.
# Empty = not wired: the UI, auth and governance all work, and a chat turn is
# refused honestly ("assistant not configured") instead of answered.
# A RAGLab on this host: http://host.docker.internal:8000
RAGLAB_URL=
# Shared secret the backend presents as X-Service-Token on every call to RAGLab.
# RAGLab requires it on every endpoint once a token is configured, and
# answers 401 without it. Leave empty only if no token is configured there.
RAGLAB_TOKEN=

# --- Development fixture (never enable on a shared host) ---
# true = seed five staff accounts (one per role + two custom roles) and three more
# customers with accounts, cards, movements, financings and beneficiaries.
# Credentials: docs/CUSTOMER_DATA_MODEL.md §5.
DEV_SEED=false
# When true, a signed-in customer's question travels with a masked, banded summary of
# their banking relationship — no amount, IBAN, card number or identity.
CUSTOMER_CONTEXT_ENABLED=true

# --- REQUIRED: JWT signing key ---
# Generate one with:  openssl rand -base64 64
# The backend has a public dev default, so leaving this empty only works on your
# own laptop — never on a shared or reachable host.
JWT_SECRET=

# --- Database ---
POSTGRES_DB=banque_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host-side port only (containers always talk to 5432 internally).
POSTGRES_PORT=5433

# --- One-off cleanup of stored answers (leave both lines as they are normally) ---
# ./deploy/update-live.sh sets these for one restart so old rows that still carry the
# engine's wording are rewritten to what a customer was actually shown. Set them to
# true/false here only if you want the cleanup to run on the next boot by itself.
#CHAT_HISTORY_BACKFILL_ENABLED=false
#CHAT_HISTORY_BACKFILL_DRY_RUN=true

# --- Host port mappings ---
FRONTEND_PORT=8080
BACKEND_PORT=8081
# Set false to fall back to Tomcat platform threads on the backend
# VIRTUAL_THREADS=true

# --- Security ---
# Browser origin allowed to call the API. With the nginx proxy the browser
# only ever talks to the frontend origin.
CORS_ALLOWED_ORIGINS=http://localhost:8080
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
