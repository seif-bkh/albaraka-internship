# ============================================================
# Al Baraka Assistant - example environment file
# Copy to .env and fill in. NEVER commit the real .env.
# ============================================================

# --- PostgreSQL (single source of truth for the backend) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=banque_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# --- Assistant: RAGLab, the only engine ---
# The RAG service is external and addressed like production: http://<ip>:<port>.
# Leave empty to run the stack without it — the console says "non configurée" and
# a chat turn is refused honestly instead of answered.
# A RAGLab running on this host: http://host.docker.internal:8000
RAGLAB_URL=
# Shared secret presented as X-Service-Token on every call to RAGLab. RAGLab
# requires it on every endpoint once a token is configured, and answers 401
# without it. Leave empty only if no token is configured there.
RAGLAB_TOKEN=

# --- Development fixture (never enable on a shared host) ---
# true = seed five staff accounts (one per role + two custom roles) and three more
# customers with accounts, cards, movements, financings and beneficiaries.
# Credentials: docs/CUSTOMER_DATA_MODEL.md §5.
DEV_SEED=false
# When true, a signed-in customer's question travels with a masked, banded summary of
# their banking relationship — no amount, IBAN, card number or identity.
CUSTOMER_CONTEXT_ENABLED=true
# 8000 is RAGLab's; nothing in this stack may bind it.
BACKEND_PORT=8081
FRONTEND_ORIGIN=http://localhost:4200

# --- Security ---
# Generate with: openssl rand -base64 64
JWT_SECRET=changeme-must-be-at-least-256-bits
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- One-off customer-history backfill (see docs/DEPLOYMENT.md §"Identity") ---
# Rows stored before "the customer copy is the stored copy" may still hold the engine's
# own wording. The read paths already clean it; these two flags close it at rest.
# Enabled with dry-run reports the count and writes nothing; apply with DRY_RUN=false.
CHAT_HISTORY_BACKFILL_ENABLED=false
CHAT_HISTORY_BACKFILL_DRY_RUN=true

# --- Promotion (deploy/promote.sh) ---
# Registry the images are pushed to and the tag they carry; leave both empty for a
# local build. The script sets GIT_SHA itself when it builds.
REGISTRY=
TAG=
