# ==============================
# Runtime data and local storage
# ==============================
scratch/

# Databases
*.db
*.sqlite
*.sqlite3

# ==============================
# Exported chat transcripts
# ==============================
# Raw copies of assistant conversations. They once carried a live API key and
# real credentials, and nothing in the codebase reads them.
chat_history*.html

# ==============================
# Logs and temporary files
# ==============================
*.log
logs/
*.tmp
*.temp
*.pid
*.swp
*.swo
*~

# ==============================
# IDE and editor files
# ==============================
.vscode/
.idea/
*.iml
*.code-workspace
.DS_Store
Thumbs.db

# ==============================
# API client local settings
# ==============================
.postman/
postman/
Apidog/

# ==============================
# Archives and generated files
# ==============================
archive/
netstat

# ==============================
# Local verify harness (verify-local.sh)
# Logs are intentionally TRACKED so the agent can read build results, so we
# un-ignore only the *.log / STATUS.txt files under verify/out.
# ==============================
verify/out/*
!verify/out/*.log
!verify/out/STATUS.txt
image-search/
